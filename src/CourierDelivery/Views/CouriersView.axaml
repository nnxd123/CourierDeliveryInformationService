<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CourierDelivery.Views.CouriersView"
             Tag="Загрузка курьеров">

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="2">
                <TextBlock Text="Курьеры и их загрузка" Classes="title"/>
                <TextBlock Classes="muted" FontSize="13"
                           Text="Активные заказы — заказы в статусе «В работе». При 10 активных заказах курьер не назначается."/>
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить" Classes="outline" VerticalAlignment="Center" Click="ReloadClick"/>
        </Grid>

        <ScrollViewer>
            <ItemsControl x:Name="CouriersList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="panel" Margin="0,0,12,12" VerticalAlignment="Top">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource HeaderBrush}"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Initial}" Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Bold" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" Classes="subtitle"/>
                                        <TextBlock Text="{Binding Transport.Name}" Classes="muted" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding User.PhoneText}" FontSize="13"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Загрузка" Classes="caption"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LoadText}" FontWeight="SemiBold" FontSize="13"/>
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="10" Value="{Binding ActiveOrders}"
                                             Classes.full="{Binding IsFull}"/>
                                <TextBlock Text="Свободных мест нет" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                           IsVisible="{Binding IsFull}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
