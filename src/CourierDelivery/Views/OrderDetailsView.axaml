<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CourierDelivery.Views.OrderDetailsView"
             Tag="Карточка заказа">

    <Grid ColumnDefinitions="*,20,340">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,8,0">
                <Button Content="← Назад к списку" Classes="back" Click="BackClick"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock x:Name="TitleText" Text="Заказ" Classes="title" VerticalAlignment="Center"/>
                    <Border x:Name="StatusBadge" Classes="status">
                        <TextBlock x:Name="StatusText"/>
                    </Border>
                </StackPanel>

                <!-- Основные сведения -->
                <Border Classes="panel">
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <Grid.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Margin" Value="0,4"/>
                            </Style>
                        </Grid.Styles>
                        <TextBlock Grid.Row="0" Text="Дата оформления" Classes="muted"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DateText"/>
                        <TextBlock Grid.Row="1" Text="Клиент" Classes="muted"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ClientText"/>
                        <TextBlock Grid.Row="2" Text="Зона доставки" Classes="muted"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ZoneText"/>
                        <TextBlock Grid.Row="3" Text="Груз" Classes="muted"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CargoText"/>
                        <TextBlock Grid.Row="4" Text="Курьер" Classes="muted"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CourierText"/>
                        <TextBlock Grid.Row="5" Text="Комментарий" Classes="muted"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="CommentText"/>
                        <TextBlock Grid.Row="6" Text="Стоимость" Classes="muted"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="CostText" FontWeight="Bold" FontSize="16"/>
                    </Grid>
                </Border>

                <!-- Адреса -->
                <Grid ColumnDefinitions="*,12,*">
                    <Border Classes="panel">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ОТПРАВЛЕНИЕ" Classes="caption" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PickupAddressText" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PickupContactText" Classes="muted" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="panel">
                        <StackPanel Spacing="4">
                            <TextBlock Text="ПОЛУЧЕНИЕ" Classes="caption" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DeliveryAddressText" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DeliveryContactText" Classes="muted" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ДЕЙСТВИЯ (набор зависит от роли) -->
        <StackPanel Grid.Column="2" Spacing="12" Margin="0,40,0,0">
            <Border x:Name="AssignPanel" Classes="panel" IsVisible="False">
                <StackPanel Spacing="8">
                    <TextBlock Text="Назначение курьера" Classes="subtitle"/>
                    <TextBlock Text="В списке только курьеры с загрузкой менее 10 заказов" Classes="muted" FontSize="12"/>
                    <ComboBox x:Name="CourierBox" HorizontalAlignment="Stretch"/>
                    <Button Content="Назначить курьера" Classes="amber" HorizontalAlignment="Stretch" Click="AssignClick"/>
                </StackPanel>
            </Border>

            <Border x:Name="StatusPanel" Classes="panel" IsVisible="False">
                <StackPanel Spacing="8">
                    <TextBlock Text="Статус заказа" Classes="subtitle"/>
                    <ComboBox x:Name="StatusBox" HorizontalAlignment="Stretch"/>
                    <Button Content="Изменить статус" Classes="outline" HorizontalAlignment="Stretch" Click="StatusClick"/>
                </StackPanel>
            </Border>

            <Button x:Name="DeliveredButton" Content="✓ Заказ доставлен" Classes="amber"
                    HorizontalAlignment="Stretch" IsVisible="False" Click="DeliveredClick"/>
            <Button x:Name="CancelButton" Content="Отменить заказ" Classes="danger"
                    HorizontalAlignment="Stretch" IsVisible="False" Click="CancelClick"/>
            <Button x:Name="DeleteButton" Content="Удалить заказ" Classes="danger"
                    HorizontalAlignment="Stretch" IsVisible="False" Click="DeleteClick"/>
            <TextBlock x:Name="ConfirmText" IsVisible="False" FontSize="12" Foreground="{StaticResource DangerBrush}"
                       Text="Нажмите ещё раз, чтобы подтвердить удаление."/>
        </StackPanel>
    </Grid>
</UserControl>
